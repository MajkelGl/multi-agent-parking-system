# ==========================================
# Azure OpenAI Configuration
# ==========================================
# URL of your Azure cloud resource
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# API Key for Azure OpenAI access
AZURE_OPENAI_API_KEY=your_azure_openai_api_key

# Deployment name of the main LLM model
LLM_MODEL_NAME=gpt-5-mini

# Endpoint URL for the embeddings model
EMBEDDINGS_ENDPOINT=https://your-resource-name.openai.azure.com/

# Deployment name of the embeddings model
EMBEDDINGS_MODEL_NAME=text-embedding-3-small

# ==========================================
# Relational Database (PostgreSQL)
# ==========================================
# Full connection URL
POSTGRES_URL=postgresql://admin:adminpassword@localhost:5432/parking_db

# Individual database variables (used by docker-compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_DB=parking_db

# ==========================================
# Vector Database (Milvus Lite)
# ==========================================
# Path to the local Milvus Lite database file
MILVUS_FILE_PATH=./milvus_parking.db

# ==========================================
# MCP Server (FastAPI) Security
# ==========================================
# Secret authorization key(custom) used by the bot to send POST requests to the FastAPI server
X_API_KEY=your_super_secret_api_key